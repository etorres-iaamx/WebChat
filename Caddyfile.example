{
	auto_https off
}

:8080 {
	@webchat_ws path /webchat/ws
	reverse_proxy @webchat_ws 127.0.0.1:8081

	@webchat_legacy path /webchat/webchat/index.php
	handle @webchat_legacy {
		respond 404
	}

	@webchat_auth_file path /webchat/index.php
	handle @webchat_auth_file {
		respond 404
	}

	@webchat_dashboard path /webchat/dashboard
	handle @webchat_dashboard {
		rewrite * /webchat/index.php
		reverse_proxy 127.0.0.1:8082
	}

	reverse_proxy 127.0.0.1:8082
}

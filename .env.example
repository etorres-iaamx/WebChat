APP_ENV=local
APP_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webchat_iaamx
DB_USERNAME=webchat
DB_PASSWORD=replace-with-database-password

# Only the PHP relay reads this credential. Never expose it in browser code.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY_PREFIX=agent:main:webchat-iaamx
OPENCLAW_GATEWAY_TLS_VERIFY=1
OPENCLAW_BINARY=openclaw
OPENCLAW_PROVISIONING_ENABLED=0
OPENCLAW_AGENT_WORKSPACE_ROOT=/var/lib/openclaw/workspaces
OPENCLAW_CHANNEL_ACCOUNT_ID=default
HERMES_PROVISIONING_ENABLED=0
HERMES_HOME=
HERMES_PROFILE_PREFIX=webchat-
AGENT_ADMIN_PYTHON=python3
AGENT_ADMIN_SCRIPT=runtime/agent_admin.py
HIMALAYA_ENABLED=0
HIMALAYA_ACCOUNT=agent
HIMALAYA_FROM=xochitl.bot.iaamx@gmail.com
HIMALAYA_BINARY=himalaya
APP_ENV_LOCAL_SHOW_CODES=0

WEBCHAT_BIND_HOST=127.0.0.1
WEBCHAT_WS_PORT=8081
WEBCHAT_PUBLIC_WS_URL=wss://your-subdomain.ngrok.io/webchat/ws
WEBCHAT_PUBLIC_BASE_URL=https://your-subdomain.ngrok.io
WEBCHAT_PUBLIC_PATH=/webchat
WEBCHAT_STORAGE_PATH=
WEBCHAT_PUBLIC_WS_PATH=/webchat/ws
WEBCHAT_ALLOWED_ORIGINS=https://your-subdomain.ngrok.io
WEBCHAT_TOKEN_TTL=3600
WEBCHAT_SESSION_TTL=2592000
WEBCHAT_MAX_MESSAGE_LENGTH=4000

# Authentication sessions: 12h by default, 30d only when "Remember me" is selected.
AUTH_SESSION_TTL_SHORT=43200
AUTH_SESSION_TTL_PERSISTENT=2592000
AUTH_SESSION_IDLE_TTL=43200
